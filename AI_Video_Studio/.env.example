# Optional overrides (copy to .env next to this file). Never put API keys in source code.
# Where projects, inbox, profiles and logs live (default: %USERPROFILE%\Documents\AI_Video_Studio)
# AIVS_HOME=D:\AI_Video_Studio
# Extra folders the studio may read media from (separate with ;). Default: your user folder.
# AIVS_ALLOWED_DIRS=D:\Footage;E:\Clients
# Explicit FFmpeg binaries if not on PATH
# AIVS_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# AIVS_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# Whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo
# AIVS_WHISPER_MODEL=small
