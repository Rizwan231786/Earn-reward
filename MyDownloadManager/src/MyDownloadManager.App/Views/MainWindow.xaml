<Window x:Class="MyDownloadManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyDownloadManager.App.ViewModels"
        Title="MyDownloadManager" Width="1180" Height="720" MinWidth="820" MinHeight="480"
        Style="{StaticResource AppWindow}" AllowDrop="True" Icon="pack://application:,,,/Assets/MyDownloadManager.ico"
        x:Name="Root">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddUrlCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteWithFileCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshLogsCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddUrlCommand}" Margin="0,0,10,0" ToolTip="Add one or more URLs (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,1,8,0" />
                            <TextBlock Text="Add URL" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ResumeCommand}" ToolTip="Resume selected">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE768;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Resume" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="Pause selected">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE769;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Pause" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding CancelCommand}" ToolTip="Cancel and discard partial data">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71A;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Cancel" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="Remove from list (Del)">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Remove" /></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrushLight}" Margin="6,4" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding StartAllCommand}" ToolTip="Resume all paused and failed downloads">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE896;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Start all" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PauseAllCommand}" ToolTip="Pause everything">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71A;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Stop all" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" ToolTip="Move up in queue">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74A;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Up" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" ToolTip="Move down in queue">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74B;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Down" /></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrushLight}" Margin="6,4" />
                    <Button Style="{StaticResource ToolButton}" x:Name="SpeedButton" Click="SpeedButton_Click" ToolTip="Global speed limit">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xEC4A;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Speed" /></StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Unlimited" Command="{Binding SetSpeedLimitCommand}" CommandParameter="0" />
                                <MenuItem Header="256 KB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="256K" />
                                <MenuItem Header="512 KB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="512K" />
                                <MenuItem Header="1 MB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="1M" />
                                <MenuItem Header="2 MB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="2M" />
                                <MenuItem Header="5 MB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="5M" />
                                <MenuItem Header="10 MB/s" Command="{Binding SetSpeedLimitCommand}" CommandParameter="10M" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings, scheduler and browser integration">
                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE713;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Settings" /></StackPanel>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{StaticResource WindowBrush}" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Width="240">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="8,0,4,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                 ToolTip="Filter by file name or URL" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource SidebarBrush}">
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource CategoryList}"
                         ItemContainerStyle="{StaticResource CategoryItem}" Margin="0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryNode}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Width="22" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrushLight}" HorizontalAlignment="Stretch" />

            <!-- Downloads -->
            <Grid Grid.Column="2" Visibility="{Binding IsLogView, Converter={StaticResource InvBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="Grid" ItemsSource="{Binding DownloadsView}" SelectedItem="{Binding SelectedDownload}"
                          SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Enter" />
                            <MenuItem Header="Show in folder" Command="{Binding OpenFolderCommand}" />
                            <Separator />
                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                            <MenuItem Header="Pause" Command="{Binding PauseCommand}" />
                            <MenuItem Header="Restart from beginning" Command="{Binding RestartCommand}" />
                            <MenuItem Header="Cancel" Command="{Binding CancelCommand}" />
                            <Separator />
                            <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}" />
                            <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                            <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                            <Separator />
                            <MenuItem Header="Remove from list" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                            <MenuItem Header="Delete file from disk" Command="{Binding DeleteWithFileCommand}" InputGestureText="Shift+Del" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="File name" Width="2.4*" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTemplateColumn Header="Progress" Width="1.3*" SortMemberPath="Progress">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource GridProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="90" />
                        <DataGridTextColumn Header="Time left" Binding="{Binding EtaText}" Width="80" />
                        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" ToolTip="{Binding Error}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Added" Binding="{Binding AddedText}" Width="120" SortMemberPath="Added" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" x:Name="EmptyState">
                    <Image Source="pack://application:,,,/Assets/icon256.png" Width="72" Opacity="0.35" />
                    <TextBlock Text="No downloads here yet" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Click Add URL, drop a link onto this window, or download from your browser." HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <!-- Details -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0"
                        Padding="14,10" Visibility="{Binding SelectedDownload, Converter={StaticResource NullToVis}}">
                    <Grid DataContext="{Binding SelectedDownload}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Address" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" />
                        <TextBlock Grid.Row="1" Text="Saved to" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Text="Type" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · connections: " /><Run Text="{Binding ConnectionsText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="3" Text="Segments" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                        <Border Grid.Row="3" Grid.Column="1" Height="12" Margin="0,8,0,0" Background="#E6EAEF" CornerRadius="3" x:Name="SegmentHost" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="Left" />
                                                    <Binding Path="ActualWidth" ElementName="SegmentHost" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SegmentBar}">
                                        <Grid Height="12">
                                            <Grid.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="Width" />
                                                    <Binding Path="ActualWidth" ElementName="SegmentHost" />
                                                </MultiBinding>
                                            </Grid.Width>
                                            <Border BorderBrush="White" BorderThickness="0,0,1,0" />
                                            <Rectangle Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" x:Name="DoneBar">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                        <Binding Path="Done" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Logs -->
            <DockPanel Grid.Column="2" Visibility="{Binding IsLogView, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Refresh (F5)" Command="{Binding RefreshLogsCommand}" />
                    <TextBlock Text="Recent events" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Logs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=G}" Width="150" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="{Binding SpeedLimitText, Mode=OneWay}" /><Run Text="   ↓ " /><Run Text="{Binding TotalSpeedText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding ActiveText}" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
